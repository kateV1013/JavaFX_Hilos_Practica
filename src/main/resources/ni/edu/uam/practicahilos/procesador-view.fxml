<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.practicahilos.ProcesadorController"
      alignment="CENTER"
      spacing="18"
      prefWidth="620"
      prefHeight="460"
      style="-fx-background-color: #f7f8fb;">

    <padding>
        <Insets top="28" right="32" bottom="28" left="32"/>
    </padding>

    <Label text="Monitor de procesos"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <VBox spacing="10"
          prefWidth="520"
          style="-fx-background-color: white; -fx-border-color: #d9dee8; -fx-border-radius: 8; -fx-background-radius: 8;">
        <padding>
            <Insets top="18" right="18" bottom="18" left="18"/>
        </padding>

        <Label text="Clientes"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <Label fx:id="lblEstadoClientes"
               text="Esperando inicio"/>

        <ProgressBar fx:id="barraClientes"
                     progress="0"
                     prefWidth="480"/>

        <Label fx:id="lblPorcentajeClientes"
               text="0%"/>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Button fx:id="btnIniciarClientes"
                    text="Iniciar clientes"
                    onAction="#iniciarClientes"/>

            <Button fx:id="btnDetenerClientes"
                    text="Detener clientes"
                    onAction="#detenerClientes"
                    disable="true"/>
        </HBox>
    </VBox>

    <VBox spacing="10"
          prefWidth="520"
          style="-fx-background-color: white; -fx-border-color: #d9dee8; -fx-border-radius: 8; -fx-background-radius: 8;">
        <padding>
            <Insets top="18" right="18" bottom="18" left="18"/>
        </padding>

        <Label text="Productos"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <Label fx:id="lblEstadoProductos"
               text="Esperando inicio"/>

        <ProgressBar fx:id="barraProductos"
                     progress="0"
                     prefWidth="480"/>

        <Label fx:id="lblPorcentajeProductos"
               text="0%"/>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Button fx:id="btnIniciarProductos"
                    text="Iniciar productos"
                    onAction="#iniciarProductos"/>

            <Button fx:id="btnDetenerProductos"
                    text="Detener productos"
                    onAction="#detenerProductos"
                    disable="true"/>
        </HBox>
    </VBox>

    <Button fx:id="btnReiniciar"
            text="Reiniciar procesos"
            onAction="#reiniciarProcesos"/>
</VBox>
