<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.practicahilos.ProcesadorController"
      alignment="TOP_CENTER"
      spacing="18"
      prefWidth="720"
      prefHeight="610"
      styleClass="app-root">

    <padding>
        <Insets top="30" right="34" bottom="30" left="34"/>
    </padding>

    <VBox spacing="6" alignment="CENTER_LEFT" maxWidth="610" styleClass="header">
        <Label text="Monitor de procesos" styleClass="title"/>
        <Label text="Practica de hilos con progreso en tiempo real" styleClass="subtitle"/>
    </VBox>

    <VBox spacing="12" maxWidth="610" styleClass="summary-card">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label text="Progreso general" styleClass="section-title"/>
                <Label fx:id="lblEstadoGeneral"
                       text="Esperando procesos"
                       styleClass="muted-text"/>
            </VBox>

            <Label fx:id="lblPorcentajeGeneral"
                   text="0%"
                   styleClass="percentage-pill"/>
        </HBox>

        <ProgressBar fx:id="barraGeneral"
                     progress="0"
                     maxWidth="Infinity"
                     minHeight="22"
                     styleClass="progress-general"/>
    </VBox>

    <HBox spacing="16" maxWidth="610">
        <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="process-card">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Clientes" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="card-title"/>
                <Label fx:id="lblPorcentajeClientes" text="0%" styleClass="small-pill"/>
            </HBox>

            <Label fx:id="lblEstadoClientes"
                   text="Esperando inicio"
                   styleClass="muted-text"/>

            <ProgressBar fx:id="barraClientes"
                         progress="0"
                         maxWidth="Infinity"
                         minHeight="18"
                         styleClass="progress-clients"/>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button fx:id="btnIniciarClientes"
                        text="Iniciar"
                        onAction="#iniciarClientes"
                        styleClass="primary-button"/>

                <Button fx:id="btnDetenerClientes"
                        text="Detener"
                        onAction="#detenerClientes"
                        disable="true"
                        styleClass="danger-button"/>
            </HBox>
        </VBox>

        <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="process-card">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Productos" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="card-title"/>
                <Label fx:id="lblPorcentajeProductos" text="0%" styleClass="small-pill"/>
            </HBox>

            <Label fx:id="lblEstadoProductos"
                   text="Esperando inicio"
                   styleClass="muted-text"/>

            <ProgressBar fx:id="barraProductos"
                         progress="0"
                         maxWidth="Infinity"
                         minHeight="18"
                         styleClass="progress-products"/>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button fx:id="btnIniciarProductos"
                        text="Iniciar"
                        onAction="#iniciarProductos"
                        styleClass="primary-button"/>

                <Button fx:id="btnDetenerProductos"
                        text="Detener"
                        onAction="#detenerProductos"
                        disable="true"
                        styleClass="danger-button"/>
            </HBox>
        </VBox>
    </HBox>

    <Button fx:id="btnReiniciar"
            text="Reiniciar procesos"
            onAction="#reiniciarProcesos"
            styleClass="reset-button"/>
</VBox>
